{
  "name": "scaffold-stellar-frontend",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names stellar,next -c gray,green --pad-prefix \"stellar scaffold watch --build-clients\" \"next dev\"",
    "init:local": "bash ./scripts/init-local.sh",
    "sync:onchain": "bash ./scripts/sync-onchain-projects.sh",
    "start": "next start",
    "dev:full": "npm run init:local && concurrently --kill-others-on-fail --names api,stellar,next -c blue,gray,green --pad-prefix \"npm --workspace packages/api run dev\" \"stellar scaffold watch --build-clients\" \"next dev\"",
    "build": "next build",
    "install:contracts": "node scripts/install-contracts.mjs",
    "preview": "next start",
    "lint": "eslint .",
    "format": "prettier . --write",
    "prepare": "husky"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^1.9.5",
    "@farcaster/mini-app-solana": "^1.1.3",
    "@privy-io/react-auth": "^3.29.2",
    "@solana-program/memo": "^0.11.1",
    "@solana-program/system": "^0.12.2",
    "@solana-program/token": "^0.13.0",
    "@solana/kit": "^6.9.0",
    "@stellar/design-system": "^3.2.5",
    "@stellar/stellar-sdk": "^14.3.3",
    "@stellar/stellar-xdr-json": "^23.0.0",
    "@stripe/crypto": "^1.1.0",
    "@tanstack/react-query": "^5.90.11",
    "autoprefixer": "^10.4.27",
    "framer-motion": "^12.38.0",
    "lossless-json": "^4.3.0",
    "lucide-react": "^0.576.0",
    "next": "^15.5.7",
    "nodemailer": "^8.0.10",
    "postcss": "^8.5.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "resend": "^6.12.4",
    "tailwindcss": "^3.4.19",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-dom": "^2.3.11",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-react-x": "^2.3.11",
    "glob": "^13.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "lint-staged": {
    "**/*": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
