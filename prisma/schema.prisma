generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProjectAxis {
  AMBIENTAL
  CULTURAL
  SOCIAL
}

enum DonationAsset {
  USDGLO
  XLM
  USDC
  BRZ
  PIX
}

enum DonationStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum EvidenceType {
  REPORT
  INVOICE_PHOTO
  CLASS_PHOTO
  TESTIMONIAL
  IMPACT_REPORT
  OTHER
}

enum EvidenceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutStatus {
  NOT_REQUESTED
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum AuditAction {
  PROJECT_CREATED
  PROJECT_APPROVED
  PROJECT_REJECTED
  PROJECT_FEATURED
  PROJECT_UNFEATURED
  EVIDENCE_CREATED
  DONATION_CONFIRMED
}

model User {
  id            String          @id @default(cuid())
  email         String?         @unique
  name          String?
  walletAddress String?
  role          String          @default("USER")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  evidences     Evidence[]
  auditLogs     AdminAuditLog[]
}

model Project {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  description       String
  organization      String
  responsibleName   String
  responsibleEmail  String
  walletAddress     String?
  pixKey            String?
  pixQrCodeUrl      String?
  goalAmount        Decimal       @db.Decimal(18, 6)
  goalAsset         DonationAsset @default(USDGLO)
  status            ProjectStatus @default(PENDING)
  featured          Boolean       @default(false)
  axes              ProjectAxis[]
  payoutProvider    String?
  payoutStatus      PayoutStatus  @default(NOT_REQUESTED)
  bankAccountLast4  String?
  payoutReference   String?
  offRampEligible   Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  donations         Donation[]
  evidences         Evidence[]
  auditLogs         AdminAuditLog[]
}

model Donation {
  id                 String         @id @default(cuid())
  projectId          String
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  donorWallet        String?
  amount             Decimal        @db.Decimal(18, 6)
  asset              DonationAsset
  network            String
  txHash             String?        @unique
  status             DonationStatus @default(PENDING)
  destinationAddress String?
  createdAt          DateTime       @default(now())
}

model Evidence {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  title       String
  description String
  type        EvidenceType
  fileUrl     String
  fileName    String?
  mimeType    String?
  status      EvidenceStatus @default(PENDING)
  createdAt   DateTime       @default(now())
}

model AdminAuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id])
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now())
}
